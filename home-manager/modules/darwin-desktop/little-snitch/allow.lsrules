      ],
      "notes": "1Password CLI (Homebrew cask, signed)"
    },
    {
      "action": "allow",
      "process": "identifier.NTY7FVCEKP/net.kovidgoyal.calibre",
      "remote-domains": [
        "calibre-ebook.com"
      ],
      "notes": "calibre updates and metadata"
    },
    {
      "action": "allow",
      "process": "any",
      "remote-domains": [
        "nixos.org",
        "flakehub.com",
        "determinate.systems",
        "cachix.org",
        "numtide.com"
      ],
      "notes": "Nix binary caches (substituters), channels, installer"
    },
    {
      "action": "allow",
      "process": "any",
      "remote-domains": [
        "github.com",
        "githubusercontent.com",
        "ghcr.io",
        "githubcopilot.com"
      ],
      "notes": "git, flake inputs, Homebrew bottles (ghcr.io), GitHub MCP"
    },
    {
      "action": "allow",
      "process": "any",
      "remote-domains": [
        "brew.sh"
      ],
      "notes": "Homebrew API"
    },
    {
      "action": "allow",
      "process": "any",
      "remote-domains": [
        "golang.org",
        "go.dev"
      ],
      "notes": "Go module proxy and checksum DB"
    },
    {
      "action": "allow",
      "process": "any",
      "remote-domains": [
        "npmjs.org",
        "pypi.org",
        "pythonhosted.org",
        "crates.io"
      ],
      "notes": "Language package registries"
    },
    {
      "action": "allow",
      "process": "any",
      "remote-domains": [
        "anthropic.com",
        "claude.ai"
      ],
      "notes": "Claude Code (Nix binary, path changes per update)"
    },
    {
      "action": "allow",
      "process": "any",
      "remote-domains": [
        "tailscale.com",
        "tailscale.io"
      ],
      "notes": "Tailscale control plane and DERP relays (tailscaled is a Nix binary)"
    },
    {
      "action": "allow",
      "process": "any",
      "remote-domains": [
        "argotunnel.com"
      ],
      "notes": "cloudflared tunnels (Homebrew binary, path changes per upgrade)"
    },
    {
      "action": "allow",
      "process": "any",
      "remote-hosts": [
        "api.cloudflare.com"
      ],
      "notes": "cloudflared tunnels (Homebrew binary, path changes per upgrade)"
    },
    {
      "action": "allow",
      "process": "identifier.APPLE/com.apple.ssh",
      "remote": "any",
      "ports": "22",
      "protocol": "tcp",
      "notes": "ssh: Ratch servers, boss-aws, GitHub"
    },
    {
      "action": "allow",
      "process": "identifier.APPLE/com.apple.ssh",
      "remote": "any",
      "ports": "2222-2223",
      "protocol": "tcp",
      "notes": "ssh: personal / ssh.ananthp.dev (2222), git.ananthp.dev (2223)"
    },
    {
      "action": "allow",
      "process": "any",
      "remote-addresses": "100.64.0.0-100.127.255.255",
      "notes": "Tailnet (Tailscale CGNAT range): own devices stay reachable on Untrusted"
    },
    {
      "action": "allow",
      "process": "any",
      "remote-hosts": [
        "gitlab.gnome.org"
      ],
      "notes": "Nix flake input hosted on GNOME GitLab"
    },
    {
      "action": "allow",
      "process": "any",
      "remote-domains": [
        "ghostty.org"
      ],
      "notes": "ghostty.nix fetches the Ghostty DMG from release.files.ghostty.org"
    },
    {
      "action": "allow",
      "process": "any",
      "remote-hosts": [
        "atuin.ananthp.dev"
      ],
      "notes": "Atuin history sync (Nix binary, path changes per update)"
    }
  ]
}
