{
  "name": "Ananth allow rules",
  "description": "Pre-allows known-good traffic so Little Snitch only asks about new connections. Apps are matched by code ID (team ID + bundle ID), which survives app updates. Unsigned Nix binaries change path on every update, so their infrastructure is allowed by domain for any process instead. Format: https://help.obdev.at/littlesnitch6/adv-lsrules-file-format",
  "rules": [
    {
      "action": "allow",
      "process": "identifier.EQHXZ8M8AV/com.google.Chrome",
      "remote": "any",
      "notes": "Browser"
    },
    {
      "action": "allow",
      "process": "identifier.EQHXZ8M8AV/com.google.Chrome.helper",
      "remote": "any",
      "notes": "Network helper: Chromium/Electron apps connect from a separate helper process with its own code ID"
    },
    {
      "action": "allow",
      "process": "identifier.EQHXZ8M8AV/com.google.GoogleUpdater",
      "remote-domains": [
        "google.com",
        "googleapis.com",
        "gvt1.com"
      ],
      "notes": "Chrome updates"
    },
    {
      "action": "allow",
      "process": "identifier.6XHFYUTQGX/com.superhuman.electron",
      "remote": "any",
      "notes": "Mail client"
    },
    {
      "action": "allow",
      "process": "identifier.6XHFYUTQGX/com.superhuman.electron.helper",
      "remote": "any",
      "notes": "Network helper: Chromium/Electron apps connect from a separate helper process with its own code ID"
    },
    {
      "action": "allow",
      "process": "identifier.Q6L2SF6YDW/com.anthropic.claudefordesktop",
      "remote": "any",
      "notes": "Claude desktop"
    },
    {
      "action": "allow",
      "process": "identifier.Q6L2SF6YDW/com.anthropic.claudefordesktop.helper",
      "remote": "any",
      "notes": "Network helper: Chromium/Electron apps connect from a separate helper process with its own code ID"
    },
    {
      "action": "allow",
      "process": "identifier.57T9237FN3/net.whatsapp.WhatsApp",
      "remote": "any",
      "notes": "Messaging"
    },
    {
      "action": "allow",
      "process": "identifier.2BUA8C4S2C/com.1password.1password",
      "remote": "any",
      "notes": "Password sync"
    },
    {
      "action": "allow",
      "process": "identifier.2BUA8C4S2C/com.1password.1password.helper",
      "remote": "any",
      "notes": "Network helper: Chromium/Electron apps connect from a separate helper process with its own code ID"
    },
    {
      "action": "allow",
      "process": "identifier.CKG9MXH72F/net.mullvad.vpn",
      "remote": "any",
      "notes": "VPN client"
    },
    {
      "action": "allow",
      "process": "identifier.HUAQ24HBR6/dev.kdrag0n.MacVirt",
      "remote": "any",
      "notes": "OrbStack: image pulls and container traffic"
    },
    {
      "action": "allow",
      "process": "identifier.T9RH74Y7L9/mega.mac",
      "remote": "any",
      "notes": "MEGA sync"
    },
    {
      "action": "allow",
      "process": "identifier.8LAYR367YV/org.zotero.zotero",
      "remote": "any",
      "notes": "Zotero sync and metadata lookups"
    },
    {
      "action": "allow",
      "process": "identifier.Q4GN9WTQK5/com.msteedman.mochi",
      "remote": "any",
      "notes": "Mochi sync"
    },
    {
      "action": "allow",
      "process": "identifier.Q4GN9WTQK5/com.msteedman.mochi.helper",
      "remote": "any",
      "notes": "Network helper: Chromium/Electron apps connect from a separate helper process with its own code ID"
    },
    {
      "action": "allow",
      "process": "identifier.679S2QUWR8/com.devon-technologies.think",
      "remote": "any",
      "notes": "DEVONthink web capture and sync"
    },
    {
      "action": "allow",
      "process": "identifier.H7H8Q7M5CK/com.postmanlabs.mac",
      "remote": "any",
      "notes": "API client: hits arbitrary hosts by design"
    },
    {
      "action": "allow",
      "process": "identifier.H7H8Q7M5CK/com.postmanlabs.mac.helper",
      "remote": "any",
      "notes": "Network helper: Chromium/Electron apps connect from a separate helper process with its own code ID"
    },
    {
      "action": "allow",
      "process": "identifier.UBF8T346G9/com.microsoft.VSCode",
