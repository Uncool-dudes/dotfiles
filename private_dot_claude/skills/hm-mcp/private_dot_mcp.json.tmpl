{
  "mcpServers": {
    "github": {
      "type": "http",
      "url": "https://api.githubcopilot.com/mcp/",
      "headers": {
        "Authorization": "Bearer {{ onepasswordRead "op://Ratch/Github MCP PAT/credential" }}",
        "X-MCP-Toolsets": "context,actions,dependabot,discussions,gists,git,governance,issues,labels,notifications,pull_requests,repos,github_support_docs_search"
      }
    }
  }
}
