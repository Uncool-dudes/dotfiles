{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "env": {
    "CLAUDE_CODE_EXPERIMENTAL_AGENT_TEAMS": "1"
  },
  "attribution": {
    "commit": "",
    "pr": ""
  },
  "permissions": {
    "allow": [
      "Write(~/projects/ratch/localconfigs/**)",
      "Edit(~/projects/ratch/localconfigs/**)"
    ],
    "defaultMode": "auto"
  },
  "model": "opus",
  "availableModels": [
    "claude-sonnet-5[1m]",
    "claude-sonnet-4-6[1m]",
    "claude-sonnet-4-6",
    "claude-opus-5-5[1m]",
    "claude-opus-5-5",
    "claude-haiku-4-5"
  ],
  "enforceAvailableModels": true,
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"$HOME/.claude/hooks/caveman-activate.js\"",
            "timeout": 5,
            "statusMessage": "Loading caveman mode..."
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"$HOME/.claude/hooks/caveman-mode-tracker.js\"",
            "timeout": 5,
            "statusMessage": "Tracking caveman mode..."
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "bash -c 'file=$(jq -r \".tool_input.file_path // empty\"); [[ \"$file\" == *.nix ]] && nixfmt \"$file\"; true'"
          },
          {
            "type": "command",
            "command": "bash -c 'file=$(jq -r \".tool_input.file_path // empty\"); [[ \"$file\" == *.go ]] && { goimports -w \"$file\"; gofumpt -w \"$file\"; }; true'"
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "atuin hook claude-code"
          }
        ]
      }
    ],
    "PostToolUseFailure": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "atuin hook claude-code"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "rtk hook claude"
          },
          {
            "type": "command",
            "command": "atuin hook claude-code"
          }
        ]
      }
    ]
  },
  "worktree": {
    "baseRef": "fresh"
  },
  "enableWorkflows": true,
  "workflowKeywordTriggerEnabled": false,
  "statusLine": {
    "type": "command",
    "command": "ccstatusline"
  },
  "enabledPlugins": {
    "gopls-lsp@claude-plugins-official": true,
    "rust-analyzer-lsp@claude-plugins-official": true
  },
  "extraKnownMarketplaces": {
    "claude-plugins-official": {
      "source": {
        "source": "directory",
        "path": "/nix/store/ik7587smsp24vdiggbsyjd74z5rjn80l-source"
      }
    }
  },
  "effortLevel": "medium",
  "modelSettings": {
    "claude-sonnet-5": {
      "autoCompactWindow": 800000
    }
  },
  "advisorModel": "opus",
  "promptSuggestionEnabled": false,
  "tui": "fullscreen",
  "voice": {
    "enabled": true,
    "mode": "tap"
  },
  "skipWorkflowUsageWarning": true,
  "theme": "dark-ansi",
  "editorMode": "normal",
  "preferredNotifChannel": "ghostty",
  "autoCompactEnabled": true,
  "switchModelsOnFlag": false,
  "remoteControlAtStartup": true,
  "inputNeededNotifEnabled": true,
  "agentPushNotifEnabled": true,
  "skipAutoPermissionPrompt": true,
  "voiceEnabled": true,
  "allow": [
    "Bash(git push *)",
    "Bash(git push)",
    "Bash(git commit *)",
    "Bash(git add *)",
    "Bash(git fetch *)",
    "Bash(git pull *)",
    "Bash(git checkout *)",
    "Bash(git switch *)",
    "Bash(git stash *)",
    "Bash(git merge *)",
    "Bash(git rebase *)",
    "Bash(git cherry-pick *)",
    "Bash(git revert *)",
    "Bash(git tag *)",
    "Bash(git restore --staged *)",
    "Bash(git status)",
    "Bash(git status *)",
    "Bash(git log *)",
    "Bash(git diff *)",
    "Bash(git show *)",
    "Bash(git blame *)",
    "Bash(git branch *)",
    "Bash(git remote *)",
    "Bash(git ls-files *)",
    "Bash(go build *)",
    "Bash(go test *)",
    "Bash(go run *)",
    "Bash(go vet *)",
    "Bash(go mod *)",
    "Bash(nix fmt *)",
    "Bash(nix build *)",
    "Bash(nix flake *)",
    "Bash(golangci-lint *)",
    "Bash(fd *)",
    "Bash(rg *)",
    "Bash(bat *)",
    "Bash(eza *)",
    "Bash(just *)"
  ]
}
